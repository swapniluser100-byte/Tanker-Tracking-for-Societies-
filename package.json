{
  "name": "jalsetu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JalSetu - water tanker and supply tracker for housing societies in Pune",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply jalsetu-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply jalsetu-db --remote",
    "db:seed:sql": "tsx scripts/seed.ts",
    "db:seed:local": "tsx scripts/seed.ts && wrangler d1 execute jalsetu-db --local --file=./seed/seed.sql",
    "db:seed:remote": "tsx scripts/seed.ts && wrangler d1 execute jalsetu-db --remote --file=./seed/seed.sql",
    "admin:create": "tsx scripts/create-admin.ts",
    "icons": "node scripts/gen-icons.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
